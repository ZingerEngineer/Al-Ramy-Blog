    "@workspace/ui": "workspace:*",
    "@workspace/utilities": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.4.10",
    "clsx": "^2.1.1",
    "next": "16.1.1",
    "pino": "^10.1.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.70.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@workspace/tailwind": "workspace:*",
    "@workspace/typescript": "workspace:*",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
