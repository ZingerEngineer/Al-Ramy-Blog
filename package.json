{
  "name": "@workspace/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Al-Ramy Blog - Monorepo for webapp and admin dashboard",
  "scripts": {
    "dev": "turbo dev",
    "dev:webapp": "turbo dev --filter=webapp",
    "dev:adminapp": "turbo dev --filter=adminapp",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "pnpm -r test",
    "clean": "turbo clean && rimraf node_modules .turbo",
    "db:generate": "dotenv -e .env -- pnpm --filter @workspace/database prisma:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @workspace/database prisma:migrate",
    "db:studio": "dotenv -e .env -- pnpm --filter @workspace/database prisma:studio",
    "db:seed": "dotenv -e .env -- pnpm --filter @workspace/database db:seed",
    "db:flush": "dotenv -e .env -- pnpm --filter @workspace/database db:flush",
    "podman:up": "./.podman/podman-start.sh",
    "podman:down": "./.podman/podman-down.sh",
    "podman:stop": "./.podman/podman-stop.sh",
    "podman:restart": "./.podman/podman-restart.sh",
    "podman:reset": "./.podman/podman-reset.sh",
    "podman:status": "./.podman/podman-status.sh",
    "podman:logs": "./.podman/podman-logs.sh",
    "podman:logs:postgres": "./.podman/podman-logs.sh postgres",
    "podman:logs:redis": "./.podman/podman-logs.sh redis",
    "podman:logs:localstack": "./.podman/podman-logs.sh localstack",
    "docker:up": "docker compose --project-directory docker-compose up -d",
    "docker:down": "docker compose --project-directory docker-compose down",
    "docker:stop": "docker compose --project-directory docker-compose stop",
    "docker:restart": "docker compose --project-directory docker-compose restart",
    "docker:reset": "docker compose --project-directory docker-compose down -v && docker compose --project-directory docker-compose up -d",
    "docker:status": "docker compose --project-directory docker-compose ps",
    "docker:logs": "docker compose --project-directory docker-compose logs -f",
    "docker:logs:db": "docker compose --project-directory docker-compose logs -f db",
    "docker:logs:cache": "docker compose --project-directory docker-compose logs -f cache",
    "docker:logs:localstack": "docker compose --project-directory docker-compose logs -f localstack",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "rimraf": "^6.1.2",
    "turbo": "^2.7.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
