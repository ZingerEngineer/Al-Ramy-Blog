{
  "name": "@workspace/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Al-Ramy Blog - Monorepo for webapp and admin dashboard",
  "scripts": {
    "dev": "turbo dev",
    "dev:webapp": "turbo dev --filter=webapp",
    "dev:admin_dashboard": "turbo dev --filter=admin_dashboard",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "pnpm -r test",
    "clean": "turbo clean && rimraf node_modules .turbo",
    "db:generate": "dotenv -e .env -- pnpm --filter @workspace/database prisma:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @workspace/database prisma:migrate",
    "db:studio": "dotenv -e .env -- pnpm --filter @workspace/database prisma:studio",
    "db:seed": "dotenv -e .env -- pnpm --filter @workspace/database db:seed",
    "db:flush": "dotenv -e .env -- pnpm --filter @workspace/database db:flush",
    "podman:up": "./scripts/podman/podman-start.sh",
    "podman:down": "./scripts/podman/podman-down.sh",
    "podman:stop": "./scripts/podman/podman-stop.sh",
    "podman:restart": "./scripts/podman/podman-restart.sh",
    "podman:reset": "./scripts/podman/podman-reset.sh",
    "podman:status": "./scripts/podman/podman-status.sh",
    "podman:logs": "./scripts/podman/podman-logs.sh",
    "podman:logs:postgres": "./scripts/podman/podman-logs.sh postgres",
    "podman:logs:redis": "./scripts/podman/podman-logs.sh redis",
    "podman:logs:localstack": "./scripts/podman/podman-logs.sh localstack",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "rimraf": "^6.1.2",
    "turbo": "^2.7.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
