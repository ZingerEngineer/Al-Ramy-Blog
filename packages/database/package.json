{
  "name": "@workspace/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "prisma:push": "dotenv -e ../../.env -- prisma db push",
    "db:seed": "dotenv -e ../../.env -- tsx src/scripts/seed.ts",
    "db:flush": "dotenv -e ../../.env -- tsx src/scripts/flush.ts",
    "db:migrate-passwords": "dotenv -e ../../.env -- tsx src/scripts/migrate-passwords.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules/.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.1",
    "@workspace/typescript": "workspace:*",
    "prisma": "^7.0.0",
    "prisma-zod-generator": "^0.8.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
